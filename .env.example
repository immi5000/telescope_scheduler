# Copy to .env and fill in. .env is gitignored and must never be committed.

# Space-Track.org — free account, required for historical orbital elements
# (gp_history) used by replay mode. https://www.space-track.org/auth/createAccount
SPACETRACK_USER=
SPACETRACK_PASS=

# Optional: broker tokens. ALeRCE's REST API needs none.
# FINK_API_TOKEN=
# ANTARES_API_KEY=
