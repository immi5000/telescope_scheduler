# The upload is the deployment: anything here that is not needed at build or
# run time is bundle budget spent for nothing, and the function has to fit in
# 250 MB uncompressed with ortools and astropy already in it.
.venv/
.git/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.playwright-mcp/
__pycache__/
*.pyc

# node_modules is ~235 MB and Vercel counts it toward the FUNCTION bundle,
# which is the whole reason the frontend is built locally and uploaded.
frontend/node_modules/

# Written at runtime, into /tmp, never from here.
data/cache/

tests/
docs/
scripts/
uv.lock
